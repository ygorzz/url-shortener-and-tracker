        "/stats/{shortUrl}": {
            "get": {
                "summary": "Display shortended URL stats",
                "description": "Display shortended URL stats like access count. The request must include a shortUrl",
                "tags": [
                    "URLs"
                ],
                "parameters": [
                    {
                        "in": "path",
                        "name": "shortUrl",
                        "schema": {
                            "type": "string"
                        },
                        "required": true,
                        "description": "The shortened URL the user wants to get stats"
                    }
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "400": {
                        "description": "The shortened URL is invalid",
