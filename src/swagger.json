        "renew/{shortUrl}": {
            "put": {
                "summary": "Shortened URL renewal",
                "description": "This route renews an expired shortened URL. The `updatedAt` field is updated. As a result, the token is renewed for another day.",
                "tags": [
                    "URLs"
                ],
                "parameters": [
                    {
                        "in": "path",
                        "name": "shortUrl",
                        "schema": {
                            "type": "string"
                        },
                        "required": true,
                        "description": "The shortened URL the user wants to renew"
                    }
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "400": {
                        "description": "The shortened URL is invalid",
                        "content": {
