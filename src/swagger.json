                                        "value": {
                                            "message": "No token provided",
                                            "status": 401
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "URL not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "URL not found",
                                            "status": 404
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "Internal Server Error",
                                            "status": 500
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "301": {
                        "description": "The client is permanently redirected to the original URL.",
                        "headers": {
                            "Location": {
                                "description": "The URL to which the client is redirected.",
                                "schema": {
                                    "type": "string",
                                    "format": "uri"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/{shortUrl}": {
