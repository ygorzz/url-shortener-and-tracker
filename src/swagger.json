{
    "openapi": "3.0.4",
    "info": {
        "title": "URL Shortener API",
        "description": "This API can shorten URLS and to track the URL's stats.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Test API"
        }
    ],
    "paths": {
        "/auth/register": {
            "post": {
                "summary": "New User registration",
                "description": "This route is responsible for register a new user. The request must include the user's name, email and password.",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterUser"
                            }
                        }
                    }
                },
                "responses": {
                    "400": {
                        "description": "The request contains invalid or missing data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "The name, email and password are required",
                                            "status": 400
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Some data already exists",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "An account with this email already exists",
                                            "status": 409
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "Internal Server Error",
                                            "status": 500
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "User registered",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RegisterUserResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
