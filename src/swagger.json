{
    "openapi": "3.0.4",
    "info": {
        "title": "URL Shortener API",
        "description": "This API aims to shorten URLs, making it easier to share very long ones—and enables the tracking of statistics, such as the number of visits (clicks), for your shared URL.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Test API"
        }
    ],
    "paths": {
        "/auth/register": {
            "post": {
                "summary": "New User registration",
                "description": "This route is responsible for registering a new user. The request must include the user's name, email, and password. The password must be between 4 and 16 characters long. The submitted email must not already be registered.",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterUser"
                            }
                        }
                    }
                },
                "responses": {
                    "400": {
                        "description": "The request contains invalid or missing data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "The name, email and password are required",
                                            "status": 400
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Some data already exists",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "An account with this email already exists",
                                            "status": 409
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "Internal Server Error",
                                            "status": 500
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "User registered",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RegisterUserResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "summary": "User's login",
                "description": "This route handles user login. The request must include the user's email and password. If no user exists with these credentials, an `Unauthorized` error is returned; otherwise, a success message and the server-generated `JWT token` are returned.",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginUser"
                            }
                        }
                    }
                },
                "responses": {
                    "400": {
                        "description": "The request contains invalid or missing data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "The email and password are required",
                                            "status": 400
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid email or password",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "No token provided",
                                            "status": 401
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "Internal Server Error",
                                            "status": 500
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginUserResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/shortUrls": {
            "post": {
                "operationId": "createShortUrl",
                "summary": "Shortened URL creation",
                "description": "This route is responsible for shortening a URL for the user. The request must include an `originalUrl` to generate the shortened version. The created shortened URL will expire after 24 hours. It requires authentication.",
                "tags": [
                    "URLs"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "originalUrl": {
                                        "type": "string",
                                        "format": "uri"
                                    }
                                },
                                "required": [
                                    "originalUrl"
                                ]
                            },
                            "examples": {
                                "shortUrl": {
                                    "value": {
                                        "originalUrl": "https://swagger.io/docs/specification/v3_0/describing-request-body/describing-request-body/"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "No token provided",
                                            "status": 401
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The request contains invalid or missing data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "The originalUrl is required",
                                            "status": 400
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "Internal Server Error",
                                            "status": 500
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CreateShortUrl"
                                }
                            }
                        }
                    }
                }
            },
            "get": {
                "operationId": "getShortUrls",
                "summary": "List of User's shortened URLs",
                "description": "This route is responsible for listing all of the user's shortened URLs. It requires authentication.",
                "tags": [
                    "URLs"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "No token provided",
                                            "status": 401
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "Internal Server Error",
                                            "status": 500
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ListShortUrl"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/shortUrls/{shortUrl}/stats": {
            "get": {
                "summary": "Display shortended URL stats",
                "description": "Displays statistics for shortened URLs, such as the access count. The request must include a `shortUrl`. It requires authentication.",
                "tags": [
                    "URLs"
                ],
                "parameters": [
                    {
                        "in": "path",
                        "name": "shortUrl",
                        "schema": {
                            "type": "string"
                        },
                        "required": true,
                        "description": "The shortened URL the user wants to get stats"
                    }
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "400": {
                        "description": "The shortened URL is invalid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "The Url is invalid",
                                            "status": 400
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "No token provided",
                                            "status": 401
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "URL not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "URL not found",
                                            "status": 404
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "Internal Server Error",
                                            "status": 500
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ListShortUrl"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/shortUrls/{shortUrl}/redirect": {
            "get": {
                "summary": "Shortened URL redirection",
                "description": "This public route redirects a shortened URL to its original URL.",
                "tags": [
                    "URLs"
                ],
                "parameters": [
                    {
                        "in": "path",
                        "name": "shortUrl",
                        "schema": {
                            "type": "string"
                        },
                        "required": true,
                        "description": "The shortened URL the user wants to redirect"
                    }
                ],
                "responses": {
                    "400": {
                        "description": "The shortened URL is invalid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "The Url is invalid",
                                            "status": 400
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "URL not found or expired",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "URL not found or expired",
                                            "status": 404
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "Internal Server Error",
                                            "status": 500
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "302": {
                        "description": "The client is temporarily redirected to the original URL. This response is not cached so access tracking and expiration validation remain accurate.",
                        "headers": {
                            "Location": {
                                "description": "The URL to which the client is redirected.",
                                "schema": {
                                    "type": "string",
                                    "format": "uri"
                                }
                            },
                            "Cache-Control": {
                                "description": "Prevents the browser from caching the redirect.",
                                "schema": {
                                    "type": "string",
                                    "example": "no-store"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/shortUrls/{shortUrl}": {
            "delete": {
                "summary": "Shortened URL deletion",
                "description": "This route is responsible for delete a shortened URL. It requires authentication.",
                "tags": [
                    "URLs"
                ],
                "parameters": [
                    {
                        "in": "path",
                        "name": "shortUrl",
                        "schema": {
                            "type": "string"
                        },
                        "required": true,
                        "description": "The shortened URL the user wants to delete"
                    }
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "400": {
                        "description": "The shortened URL is invalid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "The Url is invalid",
                                            "status": 400
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "No token provided",
                                            "status": 401
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "URL not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "URL not found",
                                            "status": 404
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "Internal Server Error",
                                            "status": 500
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DeleteShortUrl"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/shortUrls/{shortUrl}/renew": {
            "put": {
                "summary": "Shortened URL renewal",
                "description": "This route is responsible for renew an expired shortened URL. The `updatedAt` field is updated. As a result, the token is renewed for another day. It requires authentication.",
                "tags": [
                    "URLs"
                ],
                "parameters": [
                    {
                        "in": "path",
                        "name": "shortUrl",
                        "schema": {
                            "type": "string"
                        },
                        "required": true,
                        "description": "The shortened URL the user wants to renew"
                    }
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "400": {
                        "description": "The shortened URL is invalid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "The Url is invalid",
                                            "status": 400
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "No token provided",
                                            "status": 401
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "URL not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "URL not found",
                                            "status": 404
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "Internal Server Error",
                                            "status": 500
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ListShortUrl"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CreateShortUrl": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "URL successfully shortened. It will expire after 24 hours."
                    },
                    "shortUrl": {
                        "type": "object",
                        "properties": {
                            "originalUrl": {
                                "type": "string",
                                "example": "https://swagger.io/docs/specification/v3_0/describing-request-body/describing-request-body/"
                            },
                            "shortUrl": {
                                "type": "string",
                                "example": "a0b1c2"
                            },
                            "accessCount": {
                                "type": "integer",
                                "example": 3
                            },
                            "expiresAtMs": {
                                "type": "integer",
                                "example": 86400000
                            },
                            "userId": {
                                "type": "string",
                                "example": "6a6b3904722fa1381cc1354"
                            },
                            "createdAt": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "updatedAt": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "_id": {
                                "type": "string",
                                "example": "6a6a7e9gfeed683r4404caf4"
                            }
                        },
                        "required": [
                            "originalUrl"
                        ]
                    }
                }
            },
            "DeleteShortUrl": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "URL successfully removed"
                    },
                    "deletedUrl": {
                        "type": "object",
                        "properties": {
                            "originalUrl": {
                                "type": "string",
                                "example": "https://swagger.io/docs/specification/v3_0/describing-request-body/describing-request-body/"
                            },
                            "shortUrl": {
                                "type": "string",
                                "example": "a0b1c2"
                            },
                            "accessCount": {
                                "type": "integer",
                                "example": 3
                            },
                            "expiresAtMs": {
                                "type": "integer",
                                "example": 86400000
                            },
                            "userId": {
                                "type": "string",
                                "example": "6a6b3904722fa1381cc1354"
                            },
                            "createdAt": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "updatedAt": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "_id": {
                                "type": "string",
                                "example": "6a6a7e9gfeed683r4404caf4"
                            }
                        }
                    }
                }
            },
            "ListShortUrl": {
                "type": "object",
                "properties": {
                    "originalUrl": {
                        "type": "string",
                        "example": "https://swagger.io/docs/specification/v3_0/describing-request-body/describing-request-body/"
                    },
                    "shortUrl": {
                        "type": "string",
                        "example": "a0b1c2"
                    },
                    "accessCount": {
                        "type": "integer",
                        "example": 3
                    },
                    "expiresAtMs": {
                        "type": "integer",
                        "example": 86400000
                    },
                    "userId": {
                        "type": "string",
                        "example": "6a6b3904722fa1381cc1354"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "_id": {
                        "type": "string",
                        "example": "6a6a7e9gfeed683r4404caf4"
                    }
                }
            },
            "RegisterUser": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "labubu"
                    },
                    "email": {
                        "type": "string",
                        "example": "l@l.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "labubu123"
                    }
                },
                "required": [
                    "name",
                    "email",
                    "password"
                ]
            },
            "RegisterUserResponse": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "User registered successfully"
                    },
                    "registeredUser": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "example": "labubu"
                            },
                            "email": {
                                "type": "string",
                                "example": "l@l.com"
                            },
                            "_id": {
                                "type": "string",
                                "example": "6a6a7e9gfeed683r4404caf4"
                            }
                        }
                    }
                }
            },
            "LoginUser": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "example": "l@l.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "labubu123"
                    }
                },
                "required": [
                    "email",
                    "password"
                ]
            },
            "LoginUserResponse": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Login successful"
                    },
                    "token": {
                        "type": "string",
                        "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
                    }
                }
            },
            "Error": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer"
                    }
                }
            }
        },
