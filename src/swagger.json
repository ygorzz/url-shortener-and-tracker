                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "No token provided",
                                            "status": 401
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The request contains invalid or missing data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "The originalUrl is required",
                                            "status": 400
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "Internal Server Error",
                                            "status": 500
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "message": {
                                        "type": "string"
                                    },
                                    "$ref": "#/components/schemas/CreateShortUrl"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/shortUrls": {
