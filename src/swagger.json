    "components": {
        "schemas": {
            "CreateShortUrl": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "URL successfully shortened. It will expire after 24 hours."
                    },
                    "shortUrl": {
                        "type": "object",
                        "properties": {
                            "originalUrl": {
                                "type": "string",
                                "example": "https://swagger.io/docs/specification/v3_0/describing-request-body/describing-request-body/"
                            },
                            "shortUrl": {
                                "type": "string",
                                "example": "a0b1c2"
                            },
                            "accessCount": {
                                "type": "integer",
                                "example": 3
                            },
                            "expiresInMs": {
                                "type": "integer",
                                "example": 86400000
                            },
                            "userId": {
                                "type": "string",
                                "example": "6a6b3904722fa1381cc1354"
                            },
                            "createdAt": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "updatedAt": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "_id": {
                                "type": "string",
                                "example": "6a6a7e9gfeed683r4404caf4"
                            }
                        }
                    }
                }
            },
            "DeleteShortUrl": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "URL successfully removed"
                    },
                    "shortUrl": {
                        "type": "object",
                        "properties": {
                            "originalUrl": {
                                "type": "string",
                                "example": "https://swagger.io/docs/specification/v3_0/describing-request-body/describing-request-body/"
                            },
                            "shortUrl": {
                                "type": "string",
                                "example": "a0b1c2"
                            },
                            "accessCount": {
                                "type": "integer",
                                "example": 3
                            },
                            "expiresInMs": {
                                "type": "integer",
                                "example": 86400000
                            },
                            "userId": {
                                "type": "string",
                                "example": "6a6b3904722fa1381cc1354"
                            },
                            "createdAt": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "updatedAt": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "_id": {
                                "type": "string",
                                "example": "6a6a7e9gfeed683r4404caf4"
                            }
                        }
                    }
                }
            },
            "ListShortUrl": {
                "type": "object",
                "properties": {
                    "originalUrl": {
                        "type": "string",
                        "example": "https://swagger.io/docs/specification/v3_0/describing-request-body/describing-request-body/"
                    },
                    "shortUrl": {
                        "type": "string",
                        "example": "a0b1c2"
                    },
                    "accessCount": {
                        "type": "integer",
                        "example": 3
                    },
                    "expiresInMs": {
                        "type": "integer",
                        "example": 86400000
                    },
                    "userId": {
                        "type": "string",
                        "example": "6a6b3904722fa1381cc1354"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "_id": {
                        "type": "string",
                        "example": "6a6a7e9gfeed683r4404caf4"
                    }
                }
            },
            "RegisterUser": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "labubu"
                    },
                    "email": {
                        "type": "string",
                        "example": "l@l.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "labubu123"
                    }
                }
            },
            "RegisterUserResponse": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "User registered successfully"
                    },
                    "registeredUser": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "example": "labubu"
                            },
                            "email": {
                                "type": "string",
                                "example": "l@l.com"
                            },
                            "password": {
                                "type": "string",
                                "example": "labubu123"
                            }
                        }
                    }
                }
            },
            "LoginUser": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "example": "l@l.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "labubu123"
                    }
                }
            },
            "LoginUserResponse": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Login sucessful"
                    },
                    "token": {
                        "type": "string",
                        "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
                    }
                }
            },
            "Error": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer"
                    }
                }
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
