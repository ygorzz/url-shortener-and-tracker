                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "URL not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "URL not found",
                                            "status": 404
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "Internal Server Error",
                                            "status": 500
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ListShortUrl"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/redirect/{shortUrl}": {
            "get": {
                "summary": "Shortened URL redirection",
                "description": "This route redirects shortened URL to original URL",
                "tags": [
