        "/shortUrl": {
            "post": {
                "summary": "Shortened URL creation",
                "description": "This route is responsible for to shorten an URL for an user. The request must include an originalUrl to create a shorten from it",
                "tags": [
                    "URLs"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "originalUrl": {
                                    "type": "string"
                                }
                            },
                            "examples": {
                                "shortUrl": {
                                    "value": {
                                        "originalUrl": "https://swagger.io/docs/specification/v3_0/describing-request-body/describing-request-body/"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
